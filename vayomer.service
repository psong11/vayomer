[Unit]
Description=Vayomer (I2S mic -> whisper.cpp -> Claude -> TTS -> speaker)
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=paul
WorkingDirectory=/home/paul/vayomer
ExecStart=/home/paul/vayomer/.venv/bin/python -m uvicorn app:app --host 0.0.0.0 --port 8080 --timeout-graceful-shutdown 5
Restart=on-failure
RestartSec=3
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
