ANTHROPIC_API_KEY=sk-ant-...

# Optional: enables the ElevenLabs voices in the Voice dropdown.
# Without it the dropdown just shows the local piper voices.
ELEVENLABS_API_KEY=sk_...
# eleven_flash_v2_5 = lowest latency (~75ms). eleven_v3 = most expressive, slower.
ELEVENLABS_MODEL=eleven_flash_v2_5

